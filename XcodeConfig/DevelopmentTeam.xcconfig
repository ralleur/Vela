//
// Vela fork: signing and app identity.
//
// Upstream ignores this file, so keeping the fork's identity here avoids
// touching Shared.xcconfig and never conflicts with upstream merges.
//
// The bundle ID is the old Vela app's, so installing the fork replaces it
// on the Apple TV. The Mac app (Mac Catalyst build of the iOS target) gets
// its own ID.
//

DEVELOPMENT_TEAM = M8735KCYG5
PRODUCT_BUNDLE_IDENTIFIER = com.ralleur.vela
PRODUCT_BUNDLE_IDENTIFIER[sdk=macosx*] = com.ralleur.vela.mac
VELA_DISPLAY_NAME = Vela
VELA_APP_ICON = Vela App Icon & Top Shelf Image
VELA_IOS_APP_ICON = AppIcon-vela
VELA_IOS_ENTITLEMENTS[sdk=macosx*] = Swiftfin/Vela/Vela-Mac.entitlements
